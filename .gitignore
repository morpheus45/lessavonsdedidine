# Dépendances
node_modules/
.pnp/
.pnp.js

# Secrets — rien de ce qui suit ne doit jamais partir sur un dépôt public.
# Les clés PayPal, la chaîne de connexion Postgres et les jetons de déploiement
# vivent dans les variables d'environnement de Vercel, pas dans le code.
.env
.env.*
!.env.example
*.pem
*.key

# Base de données locale
prisma/dev.db
prisma/dev.db-journal
prisma/migrations/dev.db*

# Construction
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo

# Site construit pour GitHub Pages (généré, jamais versionné)
_site/

# Audit d'interface (généré, jamais versionné)
ui-audit/
design/.audit/

# Système
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Photos déposées depuis le backoffice en développement local.
# En production elles vont dans le stockage Netlify, pas sur le disque.
.photos-locales/

# Export statique de l'ancienne version GitHub Pages.
out/
_site/

# Base Postgres locale de développement (scripts/base-locale.mjs).
.base-locale/

# Photos produites à la construction depuis contenu/photos/.
public/photos/
